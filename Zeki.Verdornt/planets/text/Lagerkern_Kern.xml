<?xml version="1.0" encoding="utf-8"?>
<!-- Lagerkern: nachdem der Planetenkern von Erstling genommen wurde -->
<NomaiObject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/text_schema.xsd">
  <TextBlock>
    <ID>1</ID>
    <Text>LAGERKERN. Planetenkern Erstling: aus der Höhle entnommen.</Text>
  </TextBlock>
  <TextBlock>
    <ID>2</ID>
    <ParentID>1</ParentID>
    <Text>Archiv (Hyssop): Jeder Planet trägt einen solchen Kern. Alle stammen vom selben Herzen.</Text>
  </TextBlock>
  <TextBlock>
    <ID>3</ID>
    <ParentID>2</ParentID>
    <Text>Kernschrein vor dem Herzdorn: 4 Fassungen. Bei 4 eingesetzten Kernen öffnet sich der Weg nach innen.</Text>
  </TextBlock>
  <TextBlock>
    <ID>4</ID>
    <ParentID>3</ParentID>
    <Text>Bewohner des Lagers: Hyssop, Rue, Tansy, Yarrow. Anwesend: keiner.</Text>
  </TextBlock>
  <ShipLogConditions>
    <RevealFact>
      <FactID>ZEKIVD_KERN_SCHREIN_RUMOR</FactID>
      <Condition>3</Condition>
    </RevealFact>
    <RevealFact>
      <FactID>ZEKIVD_VIER_RUMOR</FactID>
      <Condition>4</Condition>
    </RevealFact>
  </ShipLogConditions>
</NomaiObject>
