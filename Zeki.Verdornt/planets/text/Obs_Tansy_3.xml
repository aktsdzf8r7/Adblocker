<!-- Kristallobservatorium: hören und Kern -->
<NomaiObject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/text_schema.xsd">
  <TextBlock>
    <ID>1</ID>
    <Text>Tansy: „shii“ heißt hören. „dhuum“ heißt Kern – der Kern, aus dem ein Planet wächst.</Text>
  </TextBlock>
  <TextBlock>
    <ID>2</ID>
    <ParentID>1</ParentID>
    <Text>Tansy: Ich glaube, die Dornen hören uns, seit wir angekommen sind.</Text>
  </TextBlock>
  <TextBlock>
    <ID>3</ID>
    <ParentID>2</ParentID>
    <Text>Tansy: Rue sitzt in ihrer Treibstation auf der größten Insel im Nebel von Nebelranke.</Text>
  </TextBlock>
