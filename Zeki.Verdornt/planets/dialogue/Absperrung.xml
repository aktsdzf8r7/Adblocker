<DialogueTree xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/dialogue_schema.xsd">
  <NameField>Notiz an der Absperrung</NameField>
  <DialogueNode>
    <Name>START</Name>
    <EntryCondition>DEFAULT</EntryCondition>
    <Dialogue>
      <Page>NICHT ANFASSEN!</Page>
      <Page>Dieser Samen ist heute Morgen vom Himmel gefallen. Er raucht noch.</Page>
      <Page>Gossan sagt, er ist innen hohl. Slate sagt, er summt. Ich sage: Finger weg, bis ich ihn vermessen habe.</Page>
      <Page>– Hornfels, Observatorium</Page>
    </Dialogue>
  </DialogueNode>
</DialogueTree>
