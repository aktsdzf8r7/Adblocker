<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ZekiVerdornt</AssemblyName>
    <RootNamespace>ZekiVerdornt</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>MSB3270</NoWarn>
    <DebugType>portable</DebugType>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OWML" Version="2.15.5" />
    <PackageReference Include="OuterWildsGameLibs" Version="1.1.16.1372" />
  </ItemGroup>
  <!-- the built DLL is copied next to the NH configs of the mod -->
  <Target Name="CopyToMod" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)ZekiVerdornt.dll" DestinationFolder="..\Zeki.Verdornt" />
  </Target>
</Project>
