<?xml version="1.0" encoding="utf-8"?>
<!-- Whiteboard auf dem Felsen beim Wrack -->
<NomaiObject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/text_schema.xsd">
  <TextBlock>
    <ID>1</ID>
    <Text>Hysop: Die Sonde steckt noch im Fels. Sie ist exakt dorthin zurückgeflogen, wo wir sie abgeschossen haben.</Text>
  </TextBlock>
  <TextBlock>
    <ID>2</ID>
    <ParentID>1</ParentID>
    <Text>Borago: Wie ein Spiegel. Der Schleier gibt alles zurück, was wir ihm entgegenwerfen.</Text>
  </TextBlock>
  <TextBlock>
    <ID>3</ID>
    <ParentID>2</ParentID>
    <Text>Hysop: Dann müssen wir etwas finden, das er nicht zurückwirft.</Text>
  </TextBlock>
  <ShipLogConditions>
    <RevealFact>
      <FactID>ZEKSCHLEIER_WRACK_SPIEGEL</FactID>
      <Condition>1,2,3</Condition>
    </RevealFact>
  </ShipLogConditions>
