<?xml version="1.0" encoding="utf-8"?>
<!-- Bodenschrift am Signalturm: Ilex' Entscheidung -->
<NomaiObject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/text_schema.xsd">
  <TextBlock>
    <ID>1</ID>
    <Text>Borago: Du willst allein ins Herz? Für wie lange? Bis du stirbst?</Text>
  </TextBlock>
  <TextBlock>
    <ID>2</ID>
    <ParentID>1</ParentID>
    <Text>Ilex: So lange, bis jemand von außen kommt. Solange ich hinsehe, zerbricht der Bruch nicht weiter.</Text>
  </TextBlock>
  <TextBlock>
    <ID>3</ID>
    <ParentID>2</ParentID>
    <Text>Borago: Und wenn niemand kommt?</Text>
  </TextBlock>
  <TextBlock>
    <ID>4</ID>
    <ParentID>3</ParentID>
    <Text>Ilex: Dann habe ich euch Zeit geschenkt. Das ist genug.</Text>
  </TextBlock>
  <TextBlock>
    <ID>5</ID>
    <ParentID>3</ParentID>
    <Text>Tansy: Ich halte das Licht für dich an, Ilex. Jede Nacht.</Text>
  </TextBlock>
  <ShipLogConditions>
    <RevealFact>
      <FactID>ZEKSCHLEIER_BRUCH_ABSCHIED</FactID>
      <Condition>1,2,3,4</Condition>
    </RevealFact>
  </ShipLogConditions>
</NomaiObject>
